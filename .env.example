# ---------------------------------------------------------------------------
# JANSETU — optional configuration
#
# The app runs fully without any of this. Leave it all unset for the demo.
# ---------------------------------------------------------------------------

# Set to "remote" to route intent extraction through the API process
# (`npm run api`) instead of the built-in deterministic engine.
VITE_AI_MODE=local

# --- Server-side only (server/llm.ts). Never expose these to the browser. ---
# Any OpenAI-compatible endpoint works: OpenAI, Sarvam, Groq, Gemini's
# OpenAI-compatible layer, or a local Ollama/llama.cpp server.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# The web build calls /api through the Vite proxy. A bundled native app has no
# proxy, so it targets the host API directly (the iOS Simulator shares the
# host network). Override only if the API runs elsewhere.
# VITE_API_BASE_URL=http://127.0.0.1:8787

# API port (Vite proxies /api here in development)
# PORT=8787

# --- Assisted Filing Engine (server/filing/*, Skyvern browser automation) ---
# Without these the filing endpoints report "not-configured" and the mobile
# UI shows a clear setup-needed state (never simulated success).
# SKYVERN_BASE_URL=https://api.skyvern.com
# SKYVERN_API_KEY=
# SKYVERN_MODE=cloud            # "cloud" | "self-hosted"
# NOTE: Skyvern is AGPL-3.0 — review licensing before bundling it into a
#       proprietary backend. Keys stay server-side, never in the app bundle.

# --- ElevenLabs voice layer (server/voice/elevenlabs.ts) ---------------------
# The key is SERVER-SIDE ONLY. It is never sent to the browser, never put in a
# VITE_ variable, and never logged. When it is unset the app logs that it is
# using the Web Speech fallback — it never fakes audio.
# ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=P1bg08DkjqiVEzOn76yG
ELEVENLABS_TTS_MODEL_ID=eleven_v4_turbo
ELEVENLABS_STT_MODEL_ID=scribe_v1

# --- Firebase (backend: auth, Firestore, Storage, analytics) -----------------
# These are PUBLIC web config identifiers (safe in the client bundle); access is
# controlled by firestore.rules / storage.rules. Defaults point at the
# jansetu-d4e35 project, so the app connects out of the box. Override to use a
# different project.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
