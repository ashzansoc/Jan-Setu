{
  "name": "jansetu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "JANSETU — India's Voice-to-Action Network",
  "scripts": {
    "dev": "vite",
    "api": "tsx watch --env-file=.env server/index.ts",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:api\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/noto-sans-bengali": "^5.2.5",
    "@fontsource/noto-sans-devanagari": "^5.2.5",
    "@fontsource/noto-sans-tamil": "^5.2.5",
    "@hono/node-server": "^1.14.0",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tabler/icons-react": "^3.53.0",
    "@types/three": "^0.182.0",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "framer-motion": "^12.0.0",
    "hono": "^4.6.14",
    "postprocessing": "^6.39.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.182.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
